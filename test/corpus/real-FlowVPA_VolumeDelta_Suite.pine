//@version=6
indicator("FlowVPA Pro & Volume Delta Suite", shorttitle="FLOW-DELTA-PRO", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================================================
// 1. EMA WAVE CHANNEL (RAGHEE HORNER 34 EMA WAVE - JUSTUNCLEL)
// =============================================================================
grp_wave     = "1. 34 EMA Wave Channel (Preço / Suporte & Resistência)"
showWave     = input.bool(true, "Exibir 34 EMA Wave no Gráfico", group=grp_wave, tooltip="Traça a onda de 34 EMAs (Máxima, Fechamento e Mínima) no gráfico de preços.")
pacLen       = input.int(34, "Período da EMA Wave", minval=2, group=grp_wave)
waveSrc      = input.source(close, "Fonte para EMA Central", group=grp_wave)
waveHiColor  = input.color(color.rgb(0, 230, 118), "Cor Wave Superior (High)", group=grp_wave)
waveCeColor  = input.color(color.rgb(33, 150, 243), "Cor Wave Central (Close)", group=grp_wave)
waveLoColor  = input.color(color.rgb(255, 82, 82), "Cor Wave Inferior (Low)", group=grp_wave)
waveFillCol  = input.color(color.new(color.blue, 92), "Cor do Preenchimento da Onda", group=grp_wave)

pacHi = ta.ema(high, pacLen)
pacCe = ta.ema(waveSrc, pacLen)
pacLo = ta.ema(low, pacLen)

p_hi = plot(showWave ? pacHi : na, title="High Wave EMA", color=waveHiColor, linewidth=1, force_overlay=true)
p_ce = plot(showWave ? pacCe : na, title="Centre Wave EMA", color=waveCeColor, linewidth=1, force_overlay=true)
p_lo = plot(showWave ? pacLo : na, title="Low Wave EMA", color=waveLoColor, linewidth=1, force_overlay=true)
fill(p_lo, p_hi, color=showWave ? waveFillCol : na, title="Preenchimento do Canal da Onda")

// =============================================================================
// 2. COLORAÇÃO DOS CANDLES (HEATMAP DE VOLUME INSTITUCIONAL)
// =============================================================================
grp_color = "2. Coloração dos Candles (FlowVPA Heatmap)"
colorMode = input.string("Apenas Volume Relevante", "Modo de Coloração dos Candles", 
            options=["Todas as Barras (Heatmap Completo)", "Apenas Volume Relevante", "Desativado"], 
            group=grp_color, 
            tooltip="'Todas as Barras': Colore 100% dos candles conforme o desvio estatístico de volume (Z-Score).\n'Apenas Volume Relevante': Mantém as cores normais e destaca em amarelo, laranja ou vermelho o volume institucional.\n'Desativado': Mantém as cores nativas do gráfico.")

grp_hm      = "2.1 Estatísticas de Volume (Z-Score)"
volLen      = input.int(80, "Volume Baseline Length", minval=5, group=grp_hm)
thExtraHigh = input.float(3.5, "Ultra High Multiplier (Vermelho)", group=grp_hm)
thHigh      = input.float(2.1, "High Multiplier (Laranja)", group=grp_hm)
thMedium    = input.float(0.5, "Medium Multiplier (Amarelo)", group=grp_hm)
thNormal    = input.float(-1.0, "Normal Multiplier (Azul)", group=grp_hm)

c_extra = #ff1744  // Vermelho
c_high  = #ff9100  // Laranja
c_med   = #ffd600  // Amarelo
c_norm  = #00b0ff  // Azul claro
c_low   = #37474f  // Cinza escuro
c_text  = color.rgb(224, 227, 235)

v_mean = ta.sma(volume, volLen)
v_std  = ta.stdev(volume, volLen)
zScore = v_std > 0 ? (volume - v_mean) / v_std : 0.0

color zColor = c_low
if zScore >= thExtraHigh
    zColor := c_extra
else if zScore >= thHigh
    zColor := c_high
else if zScore >= thMedium
    zColor := c_med
else if zScore >= thNormal
    zColor := c_norm

color candleColor = na
if colorMode == "Todas as Barras (Heatmap Completo)"
    candleColor := zColor
else if colorMode == "Apenas Volume Relevante"
    if zScore >= thMedium
        candleColor := zColor

barcolor(candleColor)

// =============================================================================
// 3. SINAIS WYCKOFF VPA (EFFORT VS RESULT NOS CANDLES)
// =============================================================================
grp_vpa      = "3. Wyckoff VPA (Sinais nos Candles)"
showVpa      = input.bool(true, "Exibir Sinais Wyckoff nos Candles (Master)", group=grp_vpa)
showAbsBull  = input.bool(true, "Exibir Absorção de Compra (Círculo Ciano)", group=grp_vpa)
showAbsBear  = input.bool(true, "Exibir Absorção de Venda (Círculo Magenta)", group=grp_vpa)
showClxBull  = input.bool(true, "Exibir Clímax de Compra (Triângulo Verde)", group=grp_vpa)
showClxBear  = input.bool(true, "Exibir Clímax de Venda (Triângulo Vermelho)", group=grp_vpa)
showNoDemand = input.bool(true, "Exibir Sem Demanda (X Amarelo)", group=grp_vpa)
showNoSupply = input.bool(true, "Exibir Sem Oferta (X Laranja)", group=grp_vpa)
vpaLookback  = input.int(27, "VPA Average Lookback", minval=5, group=grp_vpa)
spreadLowTh  = input.float(0.35, "Spread Baixo (Absorção)", group=grp_vpa)
spreadHighTh = input.float(1.6, "Spread Alto (Clímax)", group=grp_vpa)

avg_v        = ta.sma(volume, vpaLookback)
rvol         = avg_v > 0 ? volume / avg_v : 1.0
bodySpread   = math.abs(close - open)
avg_sp       = ta.sma(bodySpread, vpaLookback)
relSpread    = avg_sp > 0 ? bodySpread / avg_sp : 1.0

isAbsorption = (zScore >= thMedium or rvol >= 1.4) and (relSpread <= spreadLowTh)
isBull       = close > open
isBear       = close < open
isClimax     = (zScore >= thHigh or rvol >= 2.0) and (relSpread >= spreadHighTh)

pipUnit       = syminfo.mintick * 10
minSpreadPips = bodySpread >= (1.0 * pipUnit)
isNoDemand    = isBull and minSpreadPips and (relSpread >= 0.8) and (zScore <= thNormal) and (rvol > 0.4 and rvol <= 0.75)
isNoSupply    = isBear and minSpreadPips and (relSpread >= 0.8) and (zScore <= thNormal) and (rvol > 0.4 and rvol <= 0.75)

plotshape(showVpa and showAbsBull and isAbsorption and isBull, title="Bullish Absorption", style=shape.circle, location=location.belowbar, color=color.aqua, size=size.tiny, force_overlay=true)
plotshape(showVpa and showAbsBear and isAbsorption and isBear, title="Bearish Absorption", style=shape.circle, location=location.abovebar, color=color.fuchsia, size=size.tiny, force_overlay=true)
plotshape(showVpa and showClxBull and isClimax and isBull, title="Bullish Climax", style=shape.triangleup, location=location.abovebar, color=color.lime, size=size.tiny, force_overlay=true)
plotshape(showVpa and showClxBear and isClimax and isBear, title="Bearish Climax", style=shape.triangledown, location=location.belowbar, color=color.red, size=size.tiny, force_overlay=true)
plotshape(showVpa and showNoDemand and isNoDemand, title="No Demand Test", style=shape.xcross, location=location.abovebar, color=color.rgb(255, 214, 0), size=size.tiny, force_overlay=true)
plotshape(showVpa and showNoSupply and isNoSupply, title="No Supply Test", style=shape.xcross, location=location.belowbar, color=color.rgb(255, 145, 0), size=size.tiny, force_overlay=true)

// =============================================================================
// 4. GATILHOS EXATOS DOS ROBÔS WYCKOFF (cBot cTrader EURUSD & US500)
// =============================================================================
grp_bot         = "4. 🤖 Gatilhos do Robô Wyckoff (Sinal Oficial cTrader)"
showBotSignals  = input.bool(true, "Exibir Setas de Sinal do Robô", group=grp_bot, tooltip="Plota uma seta grande quando ocorrem exatamente as condições programadas nos robôs cTrader.")
botProfile      = input.string("Automático", "Perfil do Robô", options=["Automático", "US500 (Só Compras / Pavio 35%)", "EURUSD (Compra e Venda / Pavio 40%)", "Personalizado"], group=grp_bot, tooltip="'Automático' detecta pelo gráfico se você está no US500 ou EURUSD e aplica as regras exatas do respectivo robô.")
botFilterHours  = input.bool(true, "Filtrar Horário de NY (14h-18h/19h UTC)", group=grp_bot, tooltip="Quando ativado, exibe os sinais apenas na janela de horário em que os robôs operam na Pepperstone.")

// Configurações personalizadas caso escolha 'Personalizado'
custCrsiLen     = input.int(24, "Período cRSI (Custom)", minval=4, group=grp_bot)
custMinWickPct  = input.float(35.0, "Pavio Mínimo (Custom %)", minval=10.0, maxval=90.0, group=grp_bot)
custCrsiOs      = input.float(25.0, "Sobrevenda cRSI (Custom)", group=grp_bot)
custCrsiOb      = input.float(75.0, "Sobrecompra cRSI (Custom)", group=grp_bot)
custUsarHtf     = input.bool(true, "Exigir Exaustão HTF (Custom)", group=grp_bot)

// Detecção e aplicação das regras específicas de cada robô
bool isUs500Ticker  = str.contains(syminfo.ticker, "500") or str.contains(syminfo.ticker, "SPX") or str.contains(syminfo.ticker, "ES")
bool isEurUsdTicker = str.contains(syminfo.ticker, "EURUSD")

bool useUs500Profile  = botProfile == "US500 (Só Compras / Pavio 35%)" or (botProfile == "Automático" and isUs500Ticker)
bool useEurUsdProfile = botProfile == "EURUSD (Compra e Venda / Pavio 40%)" or (botProfile == "Automático" and isEurUsdTicker)

int    botCrsiLen      = 24
float  botMinWickPct   = useEurUsdProfile ? 40.0 : 35.0
float  botCrsiOsThresh = useEurUsdProfile ? 22.5 : 25.0
float  botCrsiObThresh = useEurUsdProfile ? 80.0 : 75.0
bool   botUsarHtf      = true
bool   botPermiteVenda = not useUs500Profile // O robô do US500 opera estritamente 'Só Compras'

if botProfile == "Personalizado"
    botCrsiLen      := custCrsiLen
    botMinWickPct   := custMinWickPct
    botCrsiOsThresh := custCrsiOs
    botCrsiObThresh := custCrsiOb
    botUsarHtf      := custUsarHtf
    botPermiteVenda := true

// Filtro de horário de negociação em UTC (14h-19h no US500, 14h-18h no EURUSD)
string sessRobo      = useUs500Profile ? "1400-1900:23456" : "1400-1800:23456"
bool dentroDoHorario = not botFilterHours or not na(time(timeframe.period, sessRobo, "UTC"))

// Motor Cyclic RSI interno de Lars von Thienen
f_calc_crsi(s, domcycle) =>
    cyclelen   = int(domcycle / 2)
    vibration  = 10
    phasingLag = int((vibration - 1) / 2.0)
    torque     = 2.0 / (vibration + 1)
    up         = ta.rma(math.max(ta.change(s), 0), cyclelen)
    down       = ta.rma(-math.min(ta.change(s), 0), cyclelen)
    rsi        = down == 0 ? 100.0 : up == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + up / down)
    c          = 0.0
    c         := torque * (2.0 * rsi - rsi[phasingLag]) + (1.0 - torque) * nz(c[1])
    c

botCrsiLocal = f_calc_crsi(close, botCrsiLen)
botCrsiHtf   = f_calc_crsi(close, botCrsiLen * 4)

candleTotalRange = high - low
botLowerWick     = math.min(open, close) - low
botUpperWick     = high - math.max(open, close)
botLowerWickPct  = candleTotalRange > 0 ? (botLowerWick / candleTotalRange) * 100.0 : 0.0
botUpperWickPct  = candleTotalRange > 0 ? (botUpperWick / candleTotalRange) * 100.0 : 0.0

botBuySignal  = dentroDoHorario and (botCrsiLocal <= (botCrsiOsThresh + 5.0)) and (botLowerWickPct >= botMinWickPct) and (not botUsarHtf or botCrsiHtf <= 40.0)
botSellSignal = dentroDoHorario and botPermiteVenda and (botCrsiLocal >= (botCrsiObThresh - 5.0)) and (botUpperWickPct >= botMinWickPct) and (not botUsarHtf or botCrsiHtf >= 60.0)

plotshape(showBotSignals and botBuySignal and useUs500Profile, title="Sinal de Compra US500", style=shape.arrowup, location=location.belowbar, color=color.rgb(0, 255, 128), size=size.normal, text="US500\nCOMPRA", textcolor=color.rgb(0, 255, 128), force_overlay=true)
plotshape(showBotSignals and botBuySignal and not useUs500Profile, title="Sinal de Compra EURUSD", style=shape.arrowup, location=location.belowbar, color=color.rgb(0, 255, 128), size=size.normal, text="EURUSD\nCOMPRA", textcolor=color.rgb(0, 255, 128), force_overlay=true)
plotshape(showBotSignals and botSellSignal, title="Sinal de Venda EURUSD", style=shape.arrowdown, location=location.abovebar, color=color.rgb(255, 68, 68), size=size.normal, text="EURUSD\nVENDA", textcolor=color.rgb(255, 68, 68), force_overlay=true)

// =============================================================================
// 5. DELTA NUMÉRICO NOS CANDLES (TRUE DELTA LTF)
// =============================================================================
grp_delta       = "5. Delta Numérico nos Candles (True Delta LTF)"
showCandleDelta = input.bool(true, "Exibir Delta Acima dos Candles", group=grp_delta)
deltaLtf        = input.timeframe("1", "Timeframe Inferior (LTF)", group=grp_delta)
deltaSizeIn     = input.string("Tiny", "Tamanho do Texto", options=["Tiny", "Small", "Normal"], group=grp_delta)
deltaColorBuy   = input.color(#089981, "Cor Delta Positivo", group=grp_delta)
deltaColorSell  = input.color(#f23645, "Cor Delta Negativo", group=grp_delta)
deltaColorFlat  = input.color(#787b86, "Cor Delta Neutro", group=grp_delta)

deltaTxtSize    = deltaSizeIn == "Small" ? size.small : deltaSizeIn == "Normal" ? size.normal : size.tiny

b_rat      = candleTotalRange > 0 ? (close - low) / candleTotalRange : 0.5
intraDelta = (b_rat - (1.0 - b_rat)) * volume

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, deltaLtf, [open, close, volume])
int nMicroBars = array.size(ltfC)
float cDelta   = 0.0

if nMicroBars > 0
    float bVol = 0.0
    float sVol = 0.0
    for i = 0 to nMicroBars - 1
        float mv = array.get(ltfV, i)
        if mv > 0
            if array.get(ltfC, i) >= array.get(ltfO, i)
                bVol += mv
            else
                sVol += mv
    cDelta := bVol - sVol
else
    cDelta := intraDelta

f_fmt_delta(float val) =>
    string pfx = val > 0 ? "+" : ""
    pfx + str.tostring(val, format.volume)

color deltaTxtColor = cDelta > 0 ? deltaColorBuy : cDelta < 0 ? deltaColorSell : deltaColorFlat

var label liveDeltaLbl = na
if showCandleDelta
    if barstate.isconfirmed
        label.new(
            x=bar_index, y=high, 
            text=f_fmt_delta(cDelta), 
            yloc=yloc.abovebar, 
            style=label.style_none, 
            textcolor=deltaTxtColor, 
            size=deltaTxtSize, 
            force_overlay=true
        )
        liveDeltaLbl := na
    else
        if na(liveDeltaLbl)
            liveDeltaLbl := label.new(
                x=bar_index, y=high, 
                text=f_fmt_delta(cDelta), 
                yloc=yloc.abovebar, 
                style=label.style_none, 
                textcolor=deltaTxtColor, 
                size=deltaTxtSize, 
                force_overlay=true
            )
        else
            label.set_xy(liveDeltaLbl, bar_index, high)
            label.set_text(liveDeltaLbl, f_fmt_delta(cDelta))
            label.set_textcolor(liveDeltaLbl, deltaTxtColor)
            label.set_size(liveDeltaLbl, deltaTxtSize)
else
    if not na(liveDeltaLbl)
        label.delete(liveDeltaLbl)
        liveDeltaLbl := na

// =============================================================================
// 6. MULTI-SESSION VWAP & SOMBRA DAS SESSÕES
// =============================================================================
grp_vwap       = "6. Multi-Session VWAP & Sessões de Negociação"
showLondonVwap = input.bool(true,  "Exibir VWAP de Londres", group=grp_vwap)
showNyVwap     = input.bool(true,  "Exibir VWAP de Nova Iorque", group=grp_vwap)
showAsiaVwap   = input.bool(false, "Exibir VWAP da Ásia", group=grp_vwap)
minBarsVwap    = input.int(6,      "Ocultar VWAP nas primeiras X barras", minval=1, group=grp_vwap)
showSessions   = input.bool(true,  "Destacar Fundo das Sessões", group=grp_vwap)
sessTz         = input.string("UTC-3", "Fuso Horário de Referência", group=grp_vwap)
sessLondon     = input.session("0300-1130:23456", "Sessão Londres", group=grp_vwap)
sessNy         = input.session("0930-1700:23456", "Sessão Nova Iorque", group=grp_vwap)
sessAsia       = input.session("2000-0300:1234567", "Sessão Ásia", group=grp_vwap)

f_calc_vwap(s_str, tz, min_b) =>
    in_s = not na(time(timeframe.period, s_str, tz))
    is_start = in_s and not in_s[1]
    var float pv = 0.0
    var float vol = 0.0
    var int bcount = 0
    if is_start
        pv := hlc3 * volume
        vol := volume
        bcount := 1
    else if in_s
        pv += hlc3 * volume
        vol += volume
        bcount := 1
    else
        bcount := 0
        pv := 0.0
        vol := 0.0
    v_val = (in_s and vol > 0) ? (pv / vol) : na
    [in_s, is_start, (in_s and bcount >= min_b) ? v_val : na]

[in_lon, lon_start, vwap_lon]   = f_calc_vwap(sessLondon, sessTz, minBarsVwap)
[in_ny, ny_start, vwap_ny]       = f_calc_vwap(sessNy, sessTz, minBarsVwap)
[in_asia, asia_start, vwap_asia] = f_calc_vwap(sessAsia, sessTz, minBarsVwap)

plot(showLondonVwap ? vwap_lon : na,   "VWAP Londres",     color=color.orange, linewidth=2, style=plot.style_linebr, force_overlay=true)
plot(showNyVwap ? vwap_ny : na,         "VWAP Nova Iorque", color=color.aqua,   linewidth=2, style=plot.style_linebr, force_overlay=true)
plot(showAsiaVwap ? vwap_asia : na,     "VWAP Ásia",        color=color.purple, linewidth=1, style=plot.style_linebr, force_overlay=true)

var box b_lon = na
var box b_ny  = na

if showSessions
    if lon_start
        b_lon := box.new(left=bar_index, top=high, right=bar_index, bottom=low, border_width=0, bgcolor=color.new(color.blue, 94), force_overlay=true)
    else if in_lon and not na(b_lon)
        box.set_right(b_lon, bar_index)
        box.set_top(b_lon, math.max(box.get_top(b_lon), high))
        box.set_bottom(b_lon, math.min(box.get_bottom(b_lon), low))

    if ny_start
        b_ny := box.new(left=bar_index, top=high, right=bar_index, bottom=low, border_width=0, bgcolor=color.new(color.orange, 94), force_overlay=true)
    else if in_ny and not na(b_ny)
        box.set_right(b_ny, bar_index)
        box.set_top(b_ny, math.max(box.get_top(b_ny), high))
        box.set_bottom(b_ny, math.min(box.get_bottom(b_ny), low))

// =============================================================================
// 7. PRESSÃO DIRECIONAL & HUD VISUAL
// =============================================================================
grp_hud           = "7. Dashboard Display (HUD Visual)"
showTable         = input.bool(true, "Exibir Painel HUD", group=grp_hud)
hudPosInput       = input.string("Central Esquerda", "Posição do Painel", options=["Inferior Esquerdo", "Inferior Direito", "Superior Esquerdo", "Superior Direito", "Central Esquerda", "Central Direita"], group=grp_hud)
deltaThreshWeak   = input.float(100.0, "Limiar Delta Fraco/Moderado", group=grp_hud)
deltaThreshStrong = input.float(500.0, "Limiar Delta Forte", group=grp_hud)
pressLen          = input.int(8, "Lookback Pressão", minval=3, group=grp_hud)
mtfEmaLen         = input.int(27, "MTF Trend EMA Length", minval=5, group=grp_hud)

curSec = timeframe.in_seconds()
f_get_adaptive_tfs(int sec) =>
    string h1 = "15"
    string h2 = "60"
    if sec <= 60
        h1 := "5"
        h2 := "15"
    else if sec <= 300
        h1 := "15"
        h2 := "60"
    else if sec <= 1800
        h1 := "60"
        h2 := "240"
    else if sec <= 14400
        h1 := "D"
        h2 := "W"
    else
        h1 := "W"
        h2 := "M"
    [h1, h2]

[autoHtf1, autoHtf2] = f_get_adaptive_tfs(curSec)
localMtfEma = ta.ema(close, mtfEmaLen)
trendLocal  = close > localMtfEma ? 1 : -1

[closeHtf1, emaHtf1] = request.security(syminfo.tickerid, autoHtf1, [close[1], ta.ema(close, mtfEmaLen)[1]], barmerge.gaps_off, barmerge.lookahead_off)
trendHtf1 = closeHtf1 > emaHtf1 ? 1 : -1

[closeHtf2, emaHtf2] = request.security(syminfo.tickerid, autoHtf2, [close[1], ta.ema(close, mtfEmaLen)[1]], barmerge.gaps_off, barmerge.lookahead_off)
trendHtf2 = closeHtf2 > emaHtf2 ? 1 : -1

buyRatio   = candleTotalRange > 0 ? (close - low) / candleTotalRange : 0.5
sellRatio  = 1.0 - buyRatio
sumBuyVol  = math.sum(volume * buyRatio, pressLen)
sumSellVol = math.sum(volume * sellRatio, pressLen)
totVolSum  = sumBuyVol + sumSellVol
buyPct     = totVolSum > 0 ? (sumBuyVol / totVolSum) * 100.0 : 50.0
sellPct    = 100.0 - buyPct

f_render_bar(pct) =>
    int filled = math.round(math.max(0.0, math.min(100.0, pct)) / 5.0)
    string b = "["
    for i = 1 to 20
        b := b + (i <= filled ? "█" : "░")
    b := b + "]"
    b

f_fmt_tf(string tf) =>
    tf == "60" ? "1h" : tf == "120" ? "2h" : tf == "240" ? "4h" : tf == "D" or tf == "1D" ? "1D" : tf == "W" or tf == "1W" ? "1W" : tf == "M" or tf == "1M" ? "1M" : tf + "m"

string hudPos = hudPosInput == "Inferior Esquerdo" ? position.bottom_left : hudPosInput == "Superior Esquerdo" ? position.top_left : hudPosInput == "Superior Direito" ? position.top_right : hudPosInput == "Central Esquerda" ? position.middle_left : hudPosInput == "Central Direita" ? position.middle_right : position.bottom_right
var table tbl = table.new(hudPos, 2, 5, border_width=1, border_color=color.rgb(55, 71, 79), force_overlay=true)

float atrStop = ta.atr(14)
f_to_pips(val) =>
    float p = syminfo.mintick
    if syminfo.type == "forex" and (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001)
        p := syminfo.mintick * 10
    val / p
float atrPips = f_to_pips(atrStop)

if showTable and barstate.islast
    string sLoc = trendLocal == 1 ? "▲🟢" : "▼🔴"
    string sH1  = trendHtf1 == 1  ? "▲🟢" : "▼🔴"
    string sH2  = trendHtf2 == 1  ? "▲🟢" : "▼🔴"
    
    string tfText = f_fmt_tf(timeframe.period) + ":" + sLoc + " " + f_fmt_tf(autoHtf1) + ":" + sH1 + " " + f_fmt_tf(autoHtf2) + ":" + sH2
    string barText = f_render_bar(buyPct)
    color  barCol  = buyPct > 55.0 ? color.lime : sellPct > 55.0 ? color.red : c_text

    string intraText   = "Neutro ▬"
    color  intraBg     = color.rgb(30, 30, 30)
    color  intraTxtCol = c_text

    if intraDelta >= deltaThreshStrong
        intraText   := "COMPRA FORTE ▲▲"
        intraBg     := color.rgb(0, 200, 83)
        intraTxtCol := color.black
    else if intraDelta >= deltaThreshWeak
        intraText   := "Compra Fraca ▲"
        intraBg     := color.rgb(27, 94, 32)
        intraTxtCol := color.white
    else if intraDelta <= -deltaThreshStrong
        intraText   := "VENDA FORTE ▼▼"
        intraBg     := color.rgb(213, 0, 0)
        intraTxtCol := color.white
    else if intraDelta <= -deltaThreshWeak
        intraText   := "Venda Fraca ▼"
        intraBg     := color.rgb(183, 28, 28)
        intraTxtCol := color.white

    string volText = "Normal"
    color  volCol  = c_norm
    if isAbsorption
        volText := isBull ? "Absorção Compra" : "Absorção Venda"
        volCol  := isBull ? color.aqua : color.fuchsia
    else if isClimax
        volText := isBull ? "Clímax Compra" : "Clímax Venda"
        volCol  := isBull ? color.lime : color.red
    else if zScore >= thHigh
        volText := "Volume Institucional"
        volCol  := zScore >= thExtraHigh ? c_extra : c_high
    else if isNoDemand
        volText := "Sem Demanda"
        volCol  := color.rgb(255, 214, 0)
    else if isNoSupply
        volText := "Sem Oferta"
        volCol  := color.rgb(255, 145, 0)

    table.cell(tbl, 0, 0, "Timeframes", bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 0, tfText,       bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 0, 1, "Agressão",   bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 1, barText,      bgcolor=color.rgb(20, 20, 20), text_color=barCol,   text_size=size.small)
    table.cell(tbl, 0, 2, "Delta Local",bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 2, intraText,    bgcolor=intraBg,             text_color=intraTxtCol, text_size=size.small)
    table.cell(tbl, 0, 3, "Volume",     bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 3, volText,      bgcolor=color.rgb(20, 20, 20), text_color=volCol,    text_size=size.small)
    table.cell(tbl, 0, 4, "ATR",        bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(atrPips, "#.0"), bgcolor=color.rgb(20, 20, 20), text_color=color.rgb(255, 214, 0), text_size=size.small)

// =============================================================================
// 8. VOLUME DELTA OSCILLATOR WITH DIVERGENCE SIGNALS (BIGBELUGA)
// =============================================================================
grp_beluga         = "8. Volume Delta Oscillator (BigBeluga)"
deltaPeriod        = input.int(14, "Volume Delta Lookback", minval=1, group=grp_beluga)
smoothLen          = input.int(5, "Signal Smoothing Length", minval=1, group=grp_beluga)
autoScale          = input.bool(true, "Stabilize Oscillator Range", group=grp_beluga)

grp_div            = "8.1 Divergências & Níveis de Suporte/Resistência (BigBeluga)"
pivLeft            = input.int(7, "Pivot Left Lookback", minval=1, group=grp_div)
pivRight           = input.int(2, "Pivot Right Lookback", minval=1, group=grp_div)
showBullDiv        = input.bool(true, "Show Bullish Divergence Labels", group=grp_div)
showBearDiv        = input.bool(true, "Show Bearish Divergence Labels", group=grp_div)
divLabelSize       = input.string("small", "Divergence Label Size", options=["tiny", "small", "normal", "large", "huge"], group=grp_div)
showDivLines       = input.bool(true, "Show Divergence Lines on Oscillator", group=grp_div)
showDivLevels      = input.bool(true, "Show Divergence Price Levels (Gráfico)", group=grp_div)
showDivLevelsLabels= input.bool(true, "Show Price Values on Levels", group=grp_div)
maxLevels          = 5

grp_pal            = "8.2 Cores do Oscilador"
bullColor          = input.color(color.rgb(13, 176, 182), "Positive Delta Color", group=grp_pal)
bearColor          = input.color(#d65933, "Negative Delta Color", group=grp_pal)
signalColor        = input.color(#ffb74d, "Signal Line Color", group=grp_pal)
zeroColor          = input.color(#b2b5be, "Zero Level Line Color", group=grp_pal)
showSignal         = input.bool(true, "Show Signal Line", group=grp_pal)

clamp(float val, float min_val, float max_val) =>
    math.min(max_val, math.max(min_val, val))

// Volume Delta Approximation (BigBeluga)
float bbBodyRatio  = math.abs(close - open) / math.max(high - low, syminfo.mintick)
float bbVolDelta   = (close >= open ? volume * bbBodyRatio : -volume * bbBodyRatio)

float rawDeltaRatio = (bbVolDelta / math.max(volume, 1.0)) * 50.0
float deltaRatio    = clamp(rawDeltaRatio, -50.0, 50.0)

float refAlpha      = 2.0 / (14 + 1)
float curAlpha      = 2.0 / (deltaPeriod + 1)
float emaScale      = autoScale ? (refAlpha / curAlpha) * 10.0 : 10.0

float rawSmoothed   = ta.ema(deltaRatio, deltaPeriod) * emaScale
float smoothedDelta = rawSmoothed
float signalLine    = ta.wma(smoothedDelta, smoothLen)

// Divergence Engine (Pivot on smoothedDelta vs close)
float ph = ta.pivothigh(smoothedDelta, pivLeft, pivRight)
float pl = ta.pivotlow(smoothedDelta, pivLeft, pivRight)

var float prevPhOsc   = na
var float prevPhPrice = na
var int   prevPhIdx   = na

var float prevPlOsc   = na
var float prevPlPrice = na
var int   prevPlIdx   = na

bool bearDiv = false
bool bullDiv = false

int currentPivotIdx = bar_index - pivRight

var line[]  activeLines  = array.new_line()
var label[] activeLabels = array.new_label()
var float[] activePrices = array.new_float()
var bool[]  activeIsBull = array.new_bool()

trimActive(int cap) =>
    while array.size(activeLines) > cap
        line  oldL = array.shift(activeLines)
        label oldB = array.shift(activeLabels)
        array.shift(activePrices)
        array.shift(activeIsBull)
        line.delete(oldL)
        if not na(oldB)
            label.delete(oldB)

if not na(ph)
    float currentPriceHigh = high[pivRight]
    if not na(prevPhOsc) and ph < prevPhOsc and currentPriceHigh > prevPhPrice
        bearDiv := true
        if showDivLines
            line.new(
                 x1=prevPhIdx, y1=prevPhOsc, 
                 x2=currentPivotIdx, y2=ph, 
                 color=bearColor, width=2, style=line.style_solid
             )
        if showDivLevels
            line newL = line.new(
                 x1=currentPivotIdx, y1=currentPriceHigh, 
                 x2=bar_index, y2=currentPriceHigh, 
                 color=bearColor, width=1, style=line.style_solid, 
                 force_overlay=true
             )
            
            label newLbl = showDivLevelsLabels ? label.new(
                 x=bar_index, y=currentPriceHigh, 
                 text=str.tostring(currentPriceHigh, "#.##"), 
                 style=label.style_label_left, 
                 color=color.new(bearColor, 100), 
                 textcolor=bearColor, 
                 size=divLabelSize, 
                 force_overlay=true
             ) : na

            array.push(activeLines, newL)
            array.push(activeLabels, newLbl)
            array.push(activePrices, currentPriceHigh)
            array.push(activeIsBull, false)

            trimActive(maxLevels)

    prevPhOsc   := ph
    prevPhPrice := currentPriceHigh
    prevPhIdx   := currentPivotIdx

if not na(pl)
    float currentPriceLow = low[pivRight]
    if not na(prevPlOsc) and pl > prevPlOsc and currentPriceLow < prevPlPrice
        bullDiv := true
        if showDivLines
            line.new(
                 x1=prevPlIdx, y1=prevPlOsc, 
                 x2=currentPivotIdx, y2=pl, 
                 color=bullColor, width=2, style=line.style_solid
             )
        if showDivLevels
            line newL = line.new(
                 x1=currentPivotIdx, y1=currentPriceLow, 
                 x2=bar_index, y2=currentPriceLow, 
                 color=bullColor, width=1, style=line.style_solid, 
                 force_overlay=true
             )

            label newLbl = showDivLevelsLabels ? label.new(
                 x=bar_index, y=currentPriceLow, 
                 text=str.tostring(currentPriceLow, "#.##"), 
                 style=label.style_label_left, 
                 color=color.new(bullColor, 100), 
                 textcolor=bullColor, 
                 size=divLabelSize, 
                 force_overlay=true
             ) : na

            array.push(activeLines, newL)
            array.push(activeLabels, newLbl)
            array.push(activePrices, currentPriceLow)
            array.push(activeIsBull, true)

            trimActive(maxLevels)

    prevPlOsc   := pl
    prevPlPrice := currentPriceLow
    prevPlIdx   := currentPivotIdx

if array.size(activeLines) > 0
    for i = array.size(activeLines) - 1 to 0
        line  l      = array.get(activeLines, i)
        label lbl    = array.get(activeLabels, i)
        float lPrice = array.get(activePrices, i)
        bool  isBull = array.get(activeIsBull, i)

        bool crossed = isBull ? (close < lPrice) : (close > lPrice)

        if crossed
            line.set_x2(l, bar_index)
            line.set_style(l, line.style_dashed)
            if not na(lbl)
                label.set_x(lbl, bar_index)

            array.remove(activeLines, i)
            array.remove(activeLabels, i)
            array.remove(activePrices, i)
            array.remove(activeIsBull, i)
        else
            line.set_x2(l, bar_index)
            if not na(lbl)
                label.set_x(lbl, bar_index)

trimActive(maxLevels)

// Plotagem no Subpainel do Oscilador
hline(0, "Baseline", color=zeroColor, linestyle=hline.style_dashed)

obThreshold = 50
osThreshold = -50
hOB = hline(obThreshold, "Overbought Lower", color=color.new(bearColor, 100), linestyle=hline.style_dotted)
hOB_top = hline(150, "Overbought Upper", color=color.new(bearColor, 50), linestyle=hline.style_solid)
fill(hOB, hOB_top, 150, 20, color.new(bearColor, 80), color.new(bearColor, 100), title="Overbought Zone Fill")

hOS = hline(osThreshold, "Oversold Upper", color=color.new(bullColor, 100), linestyle=hline.style_dotted)
hOS_bot = hline(-150, "Oversold Lower", color=color.new(bullColor, 50), linestyle=hline.style_solid)
fill(hOS, hOS_bot, -20, -100, color.new(bullColor, 100), color.new(bullColor, 80), title="Oversold Zone Fill")

colgradient = color.from_gradient(deltaRatio, -50, 50, color.new(bearColor, 50), color.new(bullColor, 50))

plot(deltaRatio, "Raw Volume Delta", color=colgradient, style=plot.style_columns)
plot(smoothedDelta, "Smoothed Delta Shadow", color=color.new(chart.bg_color, 50), linewidth=8)
plot(smoothedDelta, "Smoothed Delta", color=chart.fg_color, linewidth=2)
plot(showSignal ? signalLine : na, "Signal Line", color=signalColor, linewidth=1)

// Etiquetas de Divergência projetadas no Gráfico de Preços (force_overlay)
if bullDiv and showBullDiv
    label.new(
         x=bar_index[pivRight], 
         y=low[pivRight], 
         text="▲\nBull", 
         style=label.style_label_up, 
         color=na, 
         textcolor=chart.fg_color, 
         size=divLabelSize, 
         force_overlay=true
     )

if bearDiv and showBearDiv
    label.new(
         x=bar_index[pivRight], 
         y=high[pivRight], 
         text="Bear\n▼", 
         style=label.style_label_down, 
         color=na, 
         textcolor=chart.fg_color, 
         size=divLabelSize, 
         force_overlay=true
     )
