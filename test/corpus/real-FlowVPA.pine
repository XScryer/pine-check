//@version=6
indicator(title="Flow VPA", shorttitle="FLOW-VPA", overlay=false, format=format.volume, precision=2, max_bars_back=500, max_labels_count=500)




// =============================================================================
// 2. SELETOR DE COLORAÇÃO DOS CANDLES
// =============================================================================
grp_color = "1. Coloração dos Candles (Heatmap de Volume)"
colorMode = input.string("Apenas Volume Relevante", "Modo de Coloração dos Candles", 
            options=["Todas as Barras (Heatmap Completo)", "Apenas Volume Relevante", "Desativado"], 
            group=grp_color, 
            tooltip="'Todas as Barras': Colore 100% dos candles conforme o desvio estatístico de volume (Z-Score).\n'Apenas Volume Relevante': Mantém as cores normais do gráfico para volume baixo/normal e destaca em amarelo, laranja ou vermelho o volume institucional.\n'Desativado': Não altera as cores nativas dos candles.")

// =============================================================================
// 3. CONFIGURAÇÕES ESTATÍSTICAS DE VOLUME (Z-SCORE)
// =============================================================================
grp_hm      = "2. Statistical Volume Heatmap (Z-Score)"
volLen      = input.int(80, "Volume Baseline Length", minval=5, group=grp_hm, tooltip="Período da média móvel e desvio padrão do volume base. Padrão campeão Pass 2449: 80.")
thExtraHigh = input.float(3.5, "Ultra High Multiplier (Stdev)", group=grp_hm, tooltip="Volume >= Média + 3.5 * Stdev. Clímax institucional extremo (Vermelho).")
thHigh      = input.float(2.1, "High Multiplier (Stdev)", group=grp_hm, tooltip="Recomendado: 2.10 (Calibrado no Campeão Pass 2449).\nVolume >= Média + 2.1 * Stdev. Forte atividade institucional (Laranja).")
thMedium    = input.float(0.5, "Medium Multiplier (Stdev)", group=grp_hm, tooltip="Recomendado: 0.50 (Calibrado no Campeão Pass 2449).\nVolume acima da média (Amarelo).")
thNormal    = input.float(-1.0, "Normal Multiplier (Stdev)", group=grp_hm, tooltip="Recomendado: -1.0 (Calibrado no Campeão Pass 2449).\nVolume normal de mercado (Azul).")

// =============================================================================
// 4. SINAIS WYCKOFF VPA (EFFORT VS RESULT NOS CANDLES)
// =============================================================================
grp_vpa      = "3. Wyckoff VPA (Effort vs. Result nos Candles)"
showVpa      = input.bool(true, "Exibir Sinais Wyckoff nos Candles (Master)", group=grp_vpa, tooltip="Chave mestra: ativa ou desativa todos os sinais Wyckoff nos candles.")
showAbsBull  = input.bool(true, "Exibir Absorção de Compra (Bull)", group=grp_vpa)
showAbsBear  = input.bool(true, "Exibir Absorção de Venda (Bear)", group=grp_vpa)
showClxBull  = input.bool(true, "Exibir Clímax de Compra (Bull)", group=grp_vpa)
showClxBear  = input.bool(true, "Exibir Clímax de Venda (Bear)", group=grp_vpa)
showNoDemand = input.bool(true, "Exibir Sem Demanda (No Demand)", group=grp_vpa)
showNoSupply = input.bool(true, "Exibir Sem Oferta (No Supply)", group=grp_vpa)
vpaLookback  = input.int(27, "VPA Average Lookback", minval=5, group=grp_vpa, tooltip="Recomendado: 27 períodos.\nComprovado em 93% dos robôs do Topo dos backtests em M2.")
spreadLowTh  = input.float(0.35, "Spread Baixo (Absorção)", group=grp_vpa, tooltip="Recomendado: 0.35 (Calibrado no Campeão Pass 2449). Identifica barras estreitas com alto esforço.")
spreadHighTh = input.float(1.6, "Spread Alto (Clímax)", group=grp_vpa, tooltip="Recomendado: 1.60. Identifica barras de expansão máxima e clímax.")

// =============================================================================
// 4. DELTA NUMÉRICO NOS CANDLES (TRUE DELTA LTF)
// =============================================================================
grp_delta       = "3.1 Delta Numérico nos Candles (True Delta LTF)"
showCandleDelta = input.bool(true, "Exibir Delta Acima dos Candles", group=grp_delta, tooltip="Exibe o valor numérico do Delta de cada vela diretamente acima dela (Verde = Positivo / Vermelho = Negativo).")
deltaLtf        = input.timeframe("1", "Timeframe Inferior (LTF)", group=grp_delta, tooltip="Timeframe dos micro-candles usado para calcular o True Delta (Padrão: 1m).")
deltaSizeIn     = input.string("Tiny", "Tamanho do Texto", options=["Tiny", "Small", "Normal"], group=grp_delta)
deltaColorBuy   = input.color(#089981, "Cor Delta Positivo (Compra)", group=grp_delta)
deltaColorSell  = input.color(#f23645, "Cor Delta Negativo (Venda)", group=grp_delta)
deltaColorFlat  = input.color(#787b86, "Cor Delta Neutro", group=grp_delta)

deltaTxtSize    = deltaSizeIn == "Small" ? size.small : deltaSizeIn == "Normal" ? size.normal : size.tiny

// =============================================================================
// 5. PRESSÃO DIRECIONAL (DELTA BIAS)
// =============================================================================
grp_press = "4. Pressão Direcional (% Compradores vs Vendedores)"
pressLen  = input.int(8, "Pressure Lookback Bars", minval=3, group=grp_press, tooltip="Recomendado: 8 barras (calibrado no campeão Pass 2449). Janela de cálculo da pressão de compradores vs vendedores.")

// =============================================================================
// 6. OSCILADOR cRSI TRÍPLICE & BANDAS ADAPTATIVAS
// =============================================================================
grp_crsi        = "5. cRSI Tríplice"
showAllCrsi     = input.bool(true, "Exibir os 3 Ciclos de cRSI", group=grp_crsi, tooltip="Exibe o ciclo Rápido (10), Base (20) e Lento (50) de Lars von Thienen.")
len1            = input.int(10, "Fast cRSI Length (Rápido)", minval=5, group=grp_crsi, tooltip="Período do ciclo rápido de momentum.")
len2            = input.int(20, "Base cRSI Length (Principal)", minval=5, group=grp_crsi, tooltip="Período do ciclo dominante central.")
len3            = input.int(50, "Slow cRSI Length (Lento)", minval=10, group=grp_crsi, tooltip="Período do ciclo estrutural macro.")

// =============================================================================
// 7. CONFIGURAÇÕES cRSI
// =============================================================================
grp_adapt       = "6. 🎯 Níveis cRSI"
crsiOsThresh    = input.float(20.3, "Extremo Estático de Sobrevenda", minval=5.0, maxval=40.0, step=0.1, group=grp_adapt, 
                  tooltip="Recomendado: 20.3.\nPresente em 90% dos testes vencedores do Topo.")
crsiObThresh    = input.float(80.2, "Extremo Estático de Sobrecompra", minval=60.0, maxval=95.0, step=0.1, group=grp_adapt, 
                  tooltip="Recomendado: 80.2.\nNível ideal calibrado para exaustão vendedora institucional.")
lrrLen          = input.int(12, "Período Base do LRR", minval=3, group=grp_adapt)
showLrrLine     = input.bool(true, "Integrar Gráfico LRR no Subpainel (Economiza Indicador)", group=grp_adapt, tooltip="Plota o LRR escalonado (0 a 100) junto com o cRSI.")


// =============================================================================
// 8. MATRIZ MULTITEMPORAL DE TENDÊNCIA (ADAPTATIVA)
// =============================================================================
grp_mtf   = "7. Multi TimeFrame"
mtfEmaLen = input.int(27, "MTF Trend EMA Length", minval=5, group=grp_mtf, 
            tooltip="Recomendado: 27 períodos (Cluster campeão dos testes entre 27 e 36).")


// Resolução em segundos do tempo atual
curSec = timeframe.in_seconds()

// Lógica de Deslizamento Multitemporal (Cascata Proporcional)
f_get_adaptive_tfs(int sec) =>
    string h1 = "15"
    string h2 = "60"
    if sec <= 60          // 1m ou menor
        h1 := "5"
        h2 := "15"
    else if sec <= 180    // 2m ou 3m
        h1 := "15"
        h2 := "60"
    else if sec <= 300    // 5m
        h1 := "15"
        h2 := "60"
    else if sec <= 900    // 15m
        h1 := "60"
        h2 := "240"
    else if sec <= 1800   // 30m
        h1 := "60"
        h2 := "240"
    else if sec <= 3600   // 1h (60m)
        h1 := "240"
        h2 := "D"
    else if sec <= 14400  // 4h (240m)
        h1 := "D"
        h2 := "W"
    else                  // Diário ou superior
        h1 := "W"
        h2 := "M"
    [h1, h2]

[autoHtf1, autoHtf2] = f_get_adaptive_tfs(curSec)

string activeHtf1 = autoHtf1
string activeHtf2 = autoHtf2



// =============================================================================
// 10. MULTI-SESSION VWAP INTELIGENTE & SESSÕES
// =============================================================================
grp_vwap       = "8. Multi-Session VWAP & Horários de Sessão"
showLondonVwap = input.bool(true,  "Exibir VWAP de Londres", group=grp_vwap)
showNyVwap     = input.bool(true,  "Exibir VWAP de Nova Iorque", group=grp_vwap)
showAsiaVwap   = input.bool(false, "Exibir VWAP da Ásia", group=grp_vwap)
minBarsVwap    = input.int(6,      "Ocultar VWAP nas primeiras X barras", minval=1, group=grp_vwap, tooltip="Mantém a linha invisível até acumular amostragem estatística suficiente.")
showSessions   = input.bool(true,  "Destacar Fundo das Sessões de Negociação", group=grp_vwap)
sessTz         = input.string("UTC-3", "Fuso Horário de Referência", group=grp_vwap)
sessLondon     = input.session("0300-1130:23456", "Sessão Londres", group=grp_vwap)
sessNy         = input.session("0930-1700:23456", "Sessão Nova Iorque", group=grp_vwap)
sessAsia       = input.session("2000-0300:1234567", "Sessão Ásia", group=grp_vwap)

// =============================================================================
// 11. PAINEL DE CONTROLE (HUD VISUAL)
// =============================================================================
grp_hud           = "9. Dashboard Display (HUD Visual)"
showTable         = input.bool(true, "Exibir Painel HUD", group=grp_hud)
hudOverlay        = input.bool(true, "Projetar HUD no Gráfico Principal", group=grp_hud, tooltip="Quando ativado, envia o HUD para o gráfico de preços (topo, baixo, lados). Desativado, ele fica dentro do subpainel do indicador.")
hudPosInput       = input.string("Central Esquerda", "Posição do Painel", options=["Inferior Esquerdo", "Inferior Direito", "Superior Esquerdo", "Superior Direito", "Central Esquerda", "Central Direita"], group=grp_hud)
deltaThreshWeak   = input.float(100.0, "Limiar Intra Delta Fraco/Moderado", group=grp_hud)
deltaThreshStrong = input.float(500.0, "Limiar Intra Delta Forte", group=grp_hud)

// ================= PALETA DE CORES INSTITUCIONAIS =================
c_extra = #ff1744  // Vermelho (Ultra High)
c_high  = #ff9100  // Laranja (High)
c_med   = #ffd600  // Amarelo (Medium)
c_norm  = #00b0ff  // Azul claro (Normal)
c_low   = #37474f  // Cinza escuro (Low)
c_text  = color.rgb(224, 227, 235)

// ================= CÁLCULO cRSI DE LARS VON THIENEN =================
f_crsi(s, domcycle) =>
    cyclelen   = int(domcycle / 2)
    vibration  = 10
    phasingLag = int((vibration - 1) / 2.0)
    torque     = 2.0 / (vibration + 1)
    up         = ta.rma(math.max(ta.change(s), 0), cyclelen)
    down       = ta.rma(-math.min(ta.change(s), 0), cyclelen)
    rsi        = down == 0 ? 100.0 : up == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + up / down)
    c          = 0.0
    c         := torque * (2.0 * rsi - rsi[phasingLag]) + (1.0 - torque) * nz(c[1])
    c

// ================= MOTOR WYCKOFF & cRSI CORE =================
f_calc_engine() =>
    c_fast   = f_crsi(close, len1)
    c_base   = f_crsi(close, len2)
    c_slow   = f_crsi(close, len3)
    rng      = high - low
    
    avg_v    = ta.sma(volume, vpaLookback)
    r_v      = avg_v > 0 ? volume / avg_v : 1.0
    v_mean   = ta.sma(volume, volLen)
    v_std    = ta.stdev(volume, volLen)
    z_sc     = v_std > 0 ? (volume - v_mean) / v_std : 0.0
    
    b_rat    = rng > 0 ? (close - low) / rng : 0.5
    i_delta  = (b_rat - (1.0 - b_rat)) * volume
    
    b_spread = math.abs(close - open)
    avg_sp   = ta.sma(b_spread, vpaLookback)
    rel_sp   = avg_sp > 0 ? b_spread / avg_sp : 1.0
    is_abs   = (z_sc >= thMedium or r_v >= 1.4) and (rel_sp <= spreadLowTh)
    
    [c_fast, c_base, c_slow, z_sc, is_abs, rel_sp, r_v, i_delta]

// Execução Local (Nativa)
[loc_c1, loc_c2, loc_c3, loc_z, loc_abs, loc_sp, loc_rv, loc_delta] = f_calc_engine()

c1           = loc_c1
c2           = loc_c2
c3           = loc_c3
zScore       = loc_z
isAbsorption = loc_abs
relSpread    = loc_sp
rvol         = loc_rv
intraDelta   = loc_delta

// Plotagem das Linhas e Zonas
p_ob = plot(crsiObThresh, title="Nível de Sobrecompra", color=color.new(color.gray, 100))
p_os = plot(crsiOsThresh, title="Nível de Sobrevenda", color=color.new(color.gray, 100))
fill(p_ob, p_os, title="Zona Neutra Estática", color=color.new(color.blue, 96))

plot(showAllCrsi ? c1 : na, title="Fast cRSI (10)", color=color.rgb(156, 175, 50, 20), linewidth=1)
plot(c2, title="Base cRSI (20)", color=color.fuchsia, linewidth=2)
plot(showAllCrsi ? c3 : na, title="Slow cRSI (50)", color=color.rgb(0, 188, 212, 20), linewidth=1)

// ================= COLORACAO DOS CANDLES (HEATMAP) =================
color zColor = c_low
if zScore >= thExtraHigh
    zColor := c_extra
else if zScore >= thHigh
    zColor := c_high
else if zScore >= thMedium
    zColor := c_med
else if zScore >= thNormal
    zColor := c_norm

color candleColor = na
if colorMode == "Todas as Barras (Heatmap Completo)"
    candleColor := zColor
else if colorMode == "Apenas Volume Relevante"
    if zScore >= thMedium
        candleColor := zColor

barcolor(candleColor)

// ================= WYCKOFF VPA SINAIS =================
isBull = close > open
isBear = close < open
isClimax = (zScore >= thHigh or rvol >= 2.0) and (relSpread >= spreadHighTh)
pipUnit = syminfo.mintick * 10
bodySpread = math.abs(close - open)
minSpreadPips = bodySpread >= (1.0 * pipUnit)
isNoDemand = isBull and minSpreadPips and (relSpread >= 0.8) and (zScore <= thNormal) and (rvol > 0.4 and rvol <= 0.75)
isNoSupply = isBear and minSpreadPips and (relSpread >= 0.8) and (zScore <= thNormal) and (rvol > 0.4 and rvol <= 0.75)

plotshape(showVpa and showAbsBull and isAbsorption and isBull, title="Bullish Absorption", style=shape.circle, location=location.belowbar, color=color.aqua, size=size.tiny, force_overlay=true)
plotshape(showVpa and showAbsBear and isAbsorption and isBear, title="Bearish Absorption", style=shape.circle, location=location.abovebar, color=color.fuchsia, size=size.tiny, force_overlay=true)
plotshape(showVpa and showClxBull and isClimax and isBull, title="Bullish Climax", style=shape.triangleup, location=location.abovebar, color=color.lime, size=size.tiny, force_overlay=true)
plotshape(showVpa and showClxBear and isClimax and isBear, title="Bearish Climax", style=shape.triangledown, location=location.belowbar, color=color.red, size=size.tiny, force_overlay=true)
plotshape(showVpa and showNoDemand and isNoDemand, title="No Demand Test", style=shape.xcross, location=location.abovebar, color=color.rgb(255, 214, 0), size=size.tiny, force_overlay=true)
plotshape(showVpa and showNoSupply and isNoSupply, title="No Supply Test", style=shape.xcross, location=location.belowbar, color=color.rgb(255, 145, 0), size=size.tiny, force_overlay=true)

// ================= DELTA NUMÉRICO ACIMA DOS CANDLES (TRUE DELTA LTF) =================
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, deltaLtf, [open, close, volume])

int nMicroBars = array.size(ltfC)
float cDelta = 0.0

if nMicroBars > 0
    float bVol = 0.0
    float sVol = 0.0
    for i = 0 to nMicroBars - 1
        float mv = array.get(ltfV, i)
        if mv > 0
            if array.get(ltfC, i) >= array.get(ltfO, i)
                bVol += mv
            else
                sVol += mv
    cDelta := bVol - sVol
else
    // Fallback gracioso para Delta nativo do FlowVPA caso o gráfico seja <= ao LTF
    cDelta := intraDelta

f_fmt_delta(float val) =>
    string pfx = val > 0 ? "+" : ""
    pfx + str.tostring(val, format.volume)

color deltaTxtColor = cDelta > 0 ? deltaColorBuy : cDelta < 0 ? deltaColorSell : deltaColorFlat

var label liveDeltaLbl = na
if showCandleDelta
    if barstate.isconfirmed
        label.new(
            x=bar_index, 
            y=high, 
            text=f_fmt_delta(cDelta), 
            yloc=yloc.abovebar, 
            style=label.style_none, 
            textcolor=deltaTxtColor, 
            size=deltaTxtSize, 
            force_overlay=true
        )
        liveDeltaLbl := na
    else
        if na(liveDeltaLbl)
            liveDeltaLbl := label.new(
                x=bar_index, 
                y=high, 
                text=f_fmt_delta(cDelta), 
                yloc=yloc.abovebar, 
                style=label.style_none, 
                textcolor=deltaTxtColor, 
                size=deltaTxtSize, 
                force_overlay=true
            )
        else
            label.set_xy(liveDeltaLbl, bar_index, high)
            label.set_text(liveDeltaLbl, f_fmt_delta(cDelta))
            label.set_textcolor(liveDeltaLbl, deltaTxtColor)
            label.set_size(liveDeltaLbl, deltaTxtSize)
else
    if not na(liveDeltaLbl)
        label.delete(liveDeltaLbl)
        liveDeltaLbl := na

// ================= MOTOR MULTITEMPORAL DE TENDÊNCIA E OSCILADOR =================
localMtfEma = ta.ema(close, mtfEmaLen)
trendLocal  = close > localMtfEma ? 1 : -1

[closeHtf1, emaHtf1] = request.security(
    syminfo.tickerid, activeHtf1, 
    [close[1], ta.ema(close, mtfEmaLen)[1]], 
    barmerge.gaps_off, barmerge.lookahead_off
)
trendHtf1 = closeHtf1 > emaHtf1 ? 1 : -1

[closeHtf2, emaHtf2] = request.security(
    syminfo.tickerid, activeHtf2, 
    [close[1], ta.ema(close, mtfEmaLen)[1]], 
    barmerge.gaps_off, barmerge.lookahead_off
)
trendHtf2 = closeHtf2 > emaHtf2 ? 1 : -1

// ================= CÁLCULO E PLOT DA MULTI-SESSION VWAP =================
f_calc_vwap(s_str, tz, min_b) =>
    in_s = not na(time(timeframe.period, s_str, tz))
    is_start = in_s and not in_s[1]
    var float pv = 0.0
    var float vol = 0.0
    var int bcount = 0
    if is_start
        pv := hlc3 * volume
        vol := volume
        bcount := 1
    else if in_s
        pv += hlc3 * volume
        vol += volume
        bcount += 1
    else
        bcount := 0
        pv := 0.0
        vol := 0.0
    v_val = (in_s and vol > 0) ? (pv / vol) : na
    [in_s, is_start, (in_s and bcount >= min_b) ? v_val : na]

[in_lon, lon_start, vwap_lon]   = f_calc_vwap(sessLondon, sessTz, minBarsVwap)
[in_ny, ny_start, vwap_ny]       = f_calc_vwap(sessNy, sessTz, minBarsVwap)
[in_asia, asia_start, vwap_asia] = f_calc_vwap(sessAsia, sessTz, minBarsVwap)

plot(showLondonVwap ? vwap_lon : na,   "VWAP Londres",     color=color.orange, linewidth=2, style=plot.style_linebr, force_overlay=true)
plot(showNyVwap ? vwap_ny : na,         "VWAP Nova Iorque", color=color.aqua,   linewidth=2, style=plot.style_linebr, force_overlay=true)
plot(showAsiaVwap ? vwap_asia : na,     "VWAP Ásia",        color=color.purple, linewidth=1, style=plot.style_linebr, force_overlay=true)

// Cálculo do LRR
float lrr = math.pow(ta.correlation(close, bar_index, lrrLen), 2)

// Plot do LRR Integrado (Escalonado de 0 a 100 para o subpainel do cRSI)
float lrr_scaled = lrr * 100.0
plot(showLrrLine ? lrr_scaled : na, title="LRR Integrado", color=color.orange, linewidth=2)




// ================= SOMBREAMENTO DAS SESSÕES NO PREÇO =================
var box b_lon = na
var box b_ny  = na

if showSessions
    if lon_start
        b_lon := box.new(left=bar_index, top=high, right=bar_index, bottom=low, border_width=0, bgcolor=color.new(color.blue, 94), force_overlay=true)
    else if in_lon and not na(b_lon)
        box.set_right(b_lon, bar_index)
        box.set_top(b_lon, math.max(box.get_top(b_lon), high))
        box.set_bottom(b_lon, math.min(box.get_bottom(b_lon), low))

    if ny_start
        b_ny := box.new(left=bar_index, top=high, right=bar_index, bottom=low, border_width=0, bgcolor=color.new(color.orange, 94), force_overlay=true)
    else if in_ny and not na(b_ny)
        box.set_right(b_ny, bar_index)
        box.set_top(b_ny, math.max(box.get_top(b_ny), high))
        box.set_bottom(b_ny, math.min(box.get_bottom(b_ny), low))

// ================= PRESSAO DIRECIONAL SUMMARY =================
range_val = high - low
buyRatio  = range_val > 0 ? (close - low) / range_val : 0.5
sellRatio = 1.0 - buyRatio
buyVol    = volume * buyRatio
sellVol   = volume * sellRatio
sumBuyVol = math.sum(buyVol, pressLen)
sumSellVol= math.sum(sellVol, pressLen)
totVolSum = sumBuyVol + sumSellVol
buyPct    = totVolSum > 0 ? (sumBuyVol / totVolSum) * 100.0 : 50.0
sellPct   = 100.0 - buyPct

// ================= HUD UNIFICADO (5 LINHAS VISUAIS) =================
f_render_bar(pct) =>
    int filled = math.round(math.max(0.0, math.min(100.0, pct)) / 5.0)
    string b = "["
    for i = 1 to 20
        b := b + (i <= filled ? "█" : "░")
    b := b + "]"
    b

f_fmt_tf(string tf) =>
    tf == "60" ? "1h" : tf == "120" ? "2h" : tf == "240" ? "4h" : tf == "D" or tf == "1D" ? "1D" : tf == "W" or tf == "1W" ? "1W" : tf == "M" or tf == "1M" ? "1M" : tf + "m"

string hudPos = hudPosInput == "Inferior Esquerdo" ? position.bottom_left : hudPosInput == "Superior Esquerdo" ? position.top_left : hudPosInput == "Superior Direito" ? position.top_right : hudPosInput == "Central Esquerda" ? position.middle_left : hudPosInput == "Central Direita" ? position.middle_right : position.bottom_right
var table tbl_sub  = table.new(hudPos, 2, 5, border_width=1, border_color=color.rgb(55, 71, 79))
var table tbl_main = table.new(hudPos, 2, 5, border_width=1, border_color=color.rgb(55, 71, 79), force_overlay=true)
table tbl = hudOverlay ? tbl_main : tbl_sub

// =============================================================================
// VOLATILIDADE (ATR)
// =============================================================================
grp_atr      = "10. Volatilidade (ATR)"
atrLenStop   = input.int(14, "ATR Length", minval=5, group=grp_atr)
float atrStop = ta.atr(atrLenStop)

f_to_pips(val) =>
    float p = syminfo.mintick
    if syminfo.type == "forex" and (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001)
        p := syminfo.mintick * 10
    val / p

float atrPips = f_to_pips(atrStop)

if showTable and barstate.islast
    string sLoc = trendLocal == 1 ? "▲🟢" : "▼🔴"
    string sH1  = trendHtf1 == 1  ? "▲🟢" : "▼🔴"
    string sH2  = trendHtf2 == 1  ? "▲🟢" : "▼🔴"
    
    string lblLoc = f_fmt_tf(timeframe.period)
    string lblH1  = f_fmt_tf(activeHtf1)
    string lblH2  = f_fmt_tf(activeHtf2)
    string tfText = lblLoc + ":" + sLoc + " " + lblH1 + ":" + sH1 + " " + lblH2 + ":" + sH2

    string barText = f_render_bar(buyPct)
    color  barCol  = buyPct > 55.0 ? color.lime : sellPct > 55.0 ? color.red : c_text

    string intraText   = "Neutro ▬"
    color  intraBg     = color.rgb(30, 30, 30)
    color  intraTxtCol = c_text

    if intraDelta >= deltaThreshStrong
        intraText   := "COMPRA FORTE ▲▲"
        intraBg     := color.rgb(0, 200, 83)
        intraTxtCol := color.black
    else if intraDelta >= deltaThreshWeak
        intraText   := "Compra Fraca ▲"
        intraBg     := color.rgb(27, 94, 32)
        intraTxtCol := color.white
    else if intraDelta <= -deltaThreshStrong
        intraText   := "VENDA FORTE ▼▼"
        intraBg     := color.rgb(213, 0, 0)
        intraTxtCol := color.white
    else if intraDelta <= -deltaThreshWeak
        intraText   := "Venda Fraca ▼"
        intraBg     := color.rgb(183, 28, 28)
        intraTxtCol := color.white

    string volText = "Normal"
    color  volCol  = c_norm

    if isAbsorption
        volText := isBull ? "Absorção Compra" : "Absorção Venda"
        volCol  := isBull ? color.aqua : color.fuchsia
    else if isClimax
        volText := isBull ? "Clímax Compra" : "Clímax Venda"
        volCol  := isBull ? color.lime : color.red
    else if zScore >= thHigh
        volText := "Volume Institucional"
        volCol  := zScore >= thExtraHigh ? c_extra : c_high
    else if isNoDemand
        volText := "Sem Demanda"
        volCol  := color.rgb(255, 214, 0)
    else if isNoSupply
        volText := "Sem Oferta"
        volCol  := color.rgb(255, 145, 0)
    else if rvol < 0.7 or zScore <= thNormal
        volText := "Sem Demanda / Seco"
        volCol  := color.rgb(120, 123, 134)

    string deltaLabel = "Delta (Local)"

    table.cell(tbl, 0, 0, "Timeframes", bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 0, tfText,       bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)

    table.cell(tbl, 0, 1, "Agressão",   bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 1, barText,      bgcolor=color.rgb(20, 20, 20), text_color=barCol,   text_size=size.small)

    table.cell(tbl, 0, 2, deltaLabel,   bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 2, intraText,    bgcolor=intraBg,             text_color=intraTxtCol, text_size=size.small)

    table.cell(tbl, 0, 3, "Volume",     bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 3, volText,      bgcolor=color.rgb(20, 20, 20), text_color=volCol,    text_size=size.small)
    
    table.cell(tbl, 0, 4, "ATR (Pips)", bgcolor=color.rgb(20, 20, 20), text_color=c_text,   text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(atrPips, "#.0"), bgcolor=color.rgb(20, 20, 20), text_color=color.rgb(255, 214, 0), text_size=size.small)



// ================= GATILHOS DE ALERTA =================
alertcondition(zScore >= thHigh, title="Volume Institucional Atípico", message="[FLOW-VPA] Volume Institucional (Alto/Clímax) em {{ticker}} ({{interval}})! Cotação: {{close}}")
